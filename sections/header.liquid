    </path>
                </g>
            </g>
        </g>
    </svg>
</a>
</div>
<div class="header__desktop__button {% if request.path contains routes.account_url %} main-menu--active{% endif %}" {{ text_hover }}>
    <a class="navlink" href="tel:{{ section.settings.phone_number }}" aria-label="Contact Us">

      <svg xmlns="http://www.w3.org/2000/svg" width="26px" height="26px" viewBox="0 -0.5 25 25" fill="none">
