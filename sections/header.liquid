        </svg>
</a>
    </div>
    <div class="header__desktop__button {% if request.path contains routes.account_url %} main-menu--active{% endif %}" {{ text_hover }}>
<a class="navlink" href="mailto:{{ section.settings.email_address }}" aria-label="Contact Us">
