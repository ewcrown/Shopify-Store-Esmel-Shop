<!-- /snippets/products-recommendation.liquid -->
 <div
      class="flickity-grid flickity-disabled-mobile"
      data-carousel
      data-grid
      data-grid-large
      data-grid-medium
      data-grid-small
      data-custom-scrollbar-items
      data-related-products
      style="
        --grid-large-items: 3;
        --grid-medium-items: 2;
        --grid-small-items: 1.5;"
      data-options='{"watchCSS": true}'>
   
      <!-- /snippets/product-grid-item.liquid -->
      {% for card_product in collections['luxe-lawn-25'].products %}
        {% unless card_product.id == product.id %}
        {%- capture placeholder -%}
          product-{%- cycle '1', '2', '3', '4', '5', '6' -%}
        {%- endcapture -%}
        <div
          class="product-grid-slide"
          data-carousel-slide
          data-item>
          {%
            render 'product-grid-item',
              product: card_product,
              placeholder: placeholder,
              columns_desktop: section.settings.grid_large,
              columns_tablet: section.settings.grid_medium,
              columns_mobile: section.settings.grid_mobile
          %}
          
        </div>
{% endunless %}
      {% endfor %}
    </div>

