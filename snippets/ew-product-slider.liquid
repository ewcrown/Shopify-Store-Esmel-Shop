<div class="ew-product-slider">
  <div class="splide" id="image-slider">
    <div class="splide__track">
      <div class="splide__list">
        {% if product.media.size > 0 %}
          {% for media_item in product.media %}
            <div class="splide__slide">
              {% if media_item.media_type == 'image' %}
                <img src="{{ media_item.src | image_url: width: 1000 }}" alt="{{ media_item.alt }}" onclick="openLightbox(this.src)">
              {% elsif media_item.media_type == 'video' %}
                <div class="ew-video-slide">
                  {{ media_item | video_tag: controls: true, autoplay: false, loop: false, muted: false }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox">
    <div class="ew-lightbox-product">
      <span class="close" onclick="closeLightbox()">✕</span>
      <img id="lightbox-img">
      <div id="lightbox-video" class="ew-lightbox-video"></div>
    </div>
  </div>
</div>
